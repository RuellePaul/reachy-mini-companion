# Where the Vite proxy sends /api (HTTP and the WebSocket). Keep localhost in dev.
VITE_MAC_AGENT_URL=http://localhost:7777

# The API key is NOT set here. The Vite proxy reads MAC_AGENT_API_KEY from the repo-root .env (the
# same line the Mac reads) and adds it as X-API-Key to the dashboard's own requests only. Never give
# it a VITE_ prefix: Vite exposes every VITE_ variable to browser JS.
# MAC_AGENT_API_KEY=   # fallback, only if the root .env has none
