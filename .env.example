# Copy this file to `.env` at the repo root and fill it in. `.env` is git-ignored: never commit it.
# `make run` and `make up` rsync it to the robot, so the robot and the Mac read the same file.

# ---- Shared by the robot and the Mac ----------------------------------------

# A Google AI Studio key (https://aistudio.google.com/apikey). The robot uses it for the Gemini Live
# conversation, the Mac for the voices of the scenes (Gemini TTS). Both are billed to this key.
GEMINI_API_KEY=

# A long random secret of your own: the robot, the Mac server and the dashboard's dev proxy all send it.
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Left empty, every route of the Mac server is open to your network.
MAC_AGENT_API_KEY=

# ---- Robot ------------------------------------------------------------------

# Where the robot reaches the Mac server: the Mac's LAN IP (reserve it on your router), not its mDNS
# name. Several addresses, comma-separated, are tried in order.
MAC_AGENT_URL=http://192.168.1.20:7777

# 0 streams the raw microphone while the robot talks or moves: you can interrupt it, and it hears itself.
# MIC_MUTE_WHILE_TALKING=1
# 1 logs the raw microphone level every 2 s (a diagnostic).
# MIC_LEVEL_LOG=0

# ---- Mac server -------------------------------------------------------------

# MAC_AGENT_PORT=7777
# The robot's daemon. The host is only used until the robot's first heartbeat tells its address.
# REACHY_HOST=reachy-mini.local
# REACHY_PORT=8000
# Where the Mac keeps its state: the settings, your scenes and apps, the re-fetchable cache.
# SETTINGS_PATH=~/.reachy/settings.json
# REACHY_STATE_DIR=~/.reachy
# REACHY_CACHE_DIR=~/.cache/reachy
# CORS_ORIGINS=http://localhost:5077,http://127.0.0.1:5077

# ---- Spotify (optional) -----------------------------------------------------

# An app of your own at https://developer.spotify.com/dashboard (a Premium account is required), with
# the redirect URI below. Then, with the Mac server running: `make spotify-auth`, once.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:7777/api/spotify/callback
# The Spotify Connect device the music plays on. Default: this Mac's own name.
# SPOTIFY_DEVICE_NAME=
